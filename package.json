{
  "name": "brebo-calculatie",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@brebo/calc-web",
    "dev:api": "npm run dev --workspace=@brebo/calc-api",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run preflight && npm run migrate && npm run start --workspace=@brebo/calc-api",
    "migrate": "npm run migrate --workspace=@brebo/calc-api",
    "preflight": "node scripts/preflight.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
